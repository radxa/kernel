			opp-hz = /bits/ 64 <1804800000>;
			opp-peak-kBps = <6835200 47318400>;
		};

		cpu4_opp_1881mhz: opp-1881600000 {
			opp-hz = /bits/ 64 <1881600000>;
			opp-peak-kBps = <6835200 47318400>;
		};

		cpu4_opp_1958mhz: opp-1958400000 {
			opp-hz = /bits/ 64 <1958400000>;
