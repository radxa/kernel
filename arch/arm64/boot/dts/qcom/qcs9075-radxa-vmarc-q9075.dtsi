&ufs_mem_hc {
	reset-gpios = <&tlmm 149 GPIO_ACTIVE_LOW>;
	vcc-supply = <&vreg_l8a>;
	vcc-max-microamp = <1100000>;
	vccq-supply = <&vreg_l4c>;
	vccq-max-microamp = <1200000>;

	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l4a>;
	vdda-pll-supply = <&vreg_l1c>;

	status = "okay";
};

/delete-node/ &usb_0_dwc3;

&usb_0 {
	reg = <0x0 0x0a600000 0x0 0x200000>;

	interrupts-extended = <&intc GIC_SPI 292 IRQ_TYPE_LEVEL_HIGH>,
			      <&intc GIC_SPI 287 IRQ_TYPE_LEVEL_HIGH>,
			      <&pdc 14 IRQ_TYPE_EDGE_BOTH>,
			      <&pdc 15 IRQ_TYPE_EDGE_BOTH>,
			      <&pdc 12 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "dwc_usb3",
			  "pwr_event",
			  "dp_hs_phy_irq",
			  "dm_hs_phy_irq",
			  "ss_phy_irq";

	iommus = <&apps_smmu 0x080 0x0>;
	phys = <&usb_0_hsphy>, <&usb_0_qmpphy>;
	phy-names = "usb2-phy", "usb3-phy";

	dr_mode = "host";
	snps,dis_u2_susphy_quirk;
	snps,dis_enblslpm_quirk;
	qcom,enable-rt;
	wakeup-source;
	vbus_dwc3-supply = <&vcc5v0_usb30_otg_regulator>;
	status = "okay";
};

&usb_0_hsphy {
	vdda-pll-supply = <&vreg_l7a>;
	vdda18-supply = <&vreg_l6c>;
	vdda33-supply = <&vreg_l9a>;

	status = "okay";
};

&usb_0_qmpphy {
	vdda-phy-supply = <&vreg_l1c>;
	vdda-pll-supply = <&vreg_l7a>;

	status = "okay";
};

/delete-node/ &usb_1_dwc3;

&usb_1 {
	reg = <0x0 0x0a800000 0x0 0x200000>;
	interrupts-extended = <&intc GIC_SPI 349 IRQ_TYPE_LEVEL_HIGH>,
				<&intc GIC_SPI 352 IRQ_TYPE_LEVEL_HIGH>,
				<&pdc 8 IRQ_TYPE_EDGE_BOTH>,
				<&pdc 7 IRQ_TYPE_EDGE_BOTH>,
				<&pdc 13 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "dwc_usb3",
			"pwr_event",
			"dp_hs_phy_irq",
			"dm_hs_phy_irq",
			"ss_phy_irq";

	iommus = <&apps_smmu 0x0a0 0x0>;
	phys = <&usb_1_hsphy>, <&usb_1_qmpphy>;
	phy-names = "usb2-phy", "usb3-phy";
	snps,dis_u2_susphy_quirk;
	snps,dis_enblslpm_quirk;
	qcom,enable-rt;
	wakeup-source;
	dr_mode = "host";
	status = "okay";
};

&usb_1_hsphy {
	vdda-pll-supply = <&vreg_l7a>;
	vdda18-supply = <&vreg_l6c>;
	vdda33-supply = <&vreg_l9a>;

	status = "okay";
};

&usb_1_qmpphy {
	vdda-phy-supply = <&vreg_l1c>;
	vdda-pll-supply = <&vreg_l7a>;

	status = "okay";
};

&usb_2 {
	status = "okay";
};

