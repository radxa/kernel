					color = <LED_COLOR_ID_YELLOW>;
				};

				led@1 {
					reg = <1>;
					active-low;
					color = <LED_COLOR_ID_GREEN>;
				};
			};
		};
	};

	mtl_rx_setup1: rx-queues-config {
		snps,rx-queues-to-use = <4>;
		snps,rx-sched-sp;

		queue0 {
			snps,dcb-algorithm;
			snps,map-to-dma-channel = <0x0>;
