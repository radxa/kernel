				#address-cells = <1>;
				#size-cells = <0>;
			};

			cci1_i2c1: i2c-bus@1 {
				reg = <1>;
				clock-frequency = <1000000>;
				#address-cells = <1>;
				#size-cells = <0>;
			};
		};

		cci2: cci@ac15000 {
			compatible = "qcom,sa8775p-cci", "qcom,msm8996-cci";

